<?xml version="1.0"?>
<sdf version="1.8">
    <model name="forest_plane">
        <static>true</static>

        <link name="link">
            <collision name="collision">
                <geometry>
                    <mesh>
                        <uri>model://forest_plane/materials/mesh/terrain.stl</uri>
                    </mesh>
                </geometry>
            </collision>

            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://forest_plane/materials/mesh/terrain.obj</uri>
                    </mesh>
                </geometry>

                <material>
                    <ambient>0.6 0.6 0.6 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <pbr>
                        <metal>
                            <albedo_map>
                                model://forest_plane/materials/textures/forest_overhead.png
                            </albedo_map>
                            <metalness>0.0</metalness>
                            <roughness>1.0</roughness>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </link>
    </model>
</sdf>