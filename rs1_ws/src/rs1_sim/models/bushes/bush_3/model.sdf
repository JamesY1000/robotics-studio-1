<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="Bush 3">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <!-- Approximate the dense, non-traversable core of the bush. -->
        <pose>-0.150 -0.113 1.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>1.35</radius>
            <length>2.1</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <!-- Keep the detailed foliage for cameras and GPU lidar. The Z
             offset places the lowest mesh vertex at model Z = 0. -->
        <pose>0 0 0.03087 1.57079 0 0</pose>
        <geometry>
          <mesh>
            <scale>5 5 5</scale>
            <uri>model://bushes/bush_3/meshes/bush_3_visual_low.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
