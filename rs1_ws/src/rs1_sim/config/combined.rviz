        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /parrot1/robot_description
      Enabled: true
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ''
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_common/Group
      Displays:
      - Alpha: 0.699999988079071
        Class: rviz_default_plugins/Map
        Color Scheme: map
        Draw Behind: false
        Enabled: false
        Name: Global Costmap
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/global_costmap/costmap
        Update Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/global_costmap/costmap_updates
        Use Timestamp: false
        Value: false
      - Alpha: 0.699999988079071
        Class: rviz_default_plugins/Map
        Color Scheme: map
        Draw Behind: false
        Enabled: true
        Name: Local Costmap
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/local_costmap/costmap
        Update Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/local_costmap/costmap_updates
        Use Timestamp: false
        Value: true
      - Alpha: 0.699999988079071
        Class: rviz_default_plugins/Map
        Color Scheme: map
        Draw Behind: false
        Enabled: false
        Name: SLAM Map
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/map
        Update Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/map_updates
        Use Timestamp: false
        Value: false
      Enabled: true
      Name: Maps
    - Class: rviz_common/Group
      Displays:
      - Alpha: 1
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 10
          Min Value: -10
          Value: true
        Axis: Z
        Channel Name: intensity
        Class: rviz_default_plugins/LaserScan
        Color: 255; 255; 255
        Color Transformer: Intensity
        Decay Time: 0
        Enabled: true
        Invert Rainbow: false
        Max Color: 255; 255; 255
        Max Intensity: 0
        Min Color: 0; 0; 0
        Min Intensity: 0
        Name: Lidar2D
        Position Transformer: XYZ
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.10000000149011612
        Style: Points
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/scan
        Use Fixed Frame: true
        Use rainbow: true
        Value: true
      - Alpha: 1
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 10
          Min Value: -10
          Value: true
        Axis: Z
        Channel Name: intensity
        Class: rviz_default_plugins/PointCloud2
        Color: 255; 255; 255
        Color Transformer: Intensity
        Decay Time: 0
        Enabled: false
        Invert Rainbow: true
        Max Color: 255; 255; 255
        Max Intensity: 0
        Min Color: 0; 0; 0
        Min Intensity: 0
        Name: Lidar3D
        Position Transformer: XYZ
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.10000000149011612
        Style: Points
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/scan/points
        Use Fixed Frame: true
        Use rainbow: true
        Value: false
      Enabled: true
      Name: Lidar
    - Class: rviz_common/Group
      Displays:
      - Alpha: 1
        Buffer Length: 1
        Class: rviz_default_plugins/Path
        Color: 0; 200; 255
        Enabled: true
        Head Diameter: 0.30000001192092896
        Head Length: 0.20000000298023224
        Length: 0.30000001192092896
        Line Style: Lines
        Line Width: 0.029999999329447746
        Name: Local Plan
        Offset:
          X: 0
          Y: 0
          Z: 0
        Pose Color: 0; 200; 255
        Pose Style: None
        Radius: 0.029999999329447746
        Shaft Diameter: 0.10000000149011612
        Shaft Length: 0.10000000149011612
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/local_plan
        Value: true
      - Alpha: 1
        Buffer Length: 1
        Class: rviz_default_plugins/Path
        Color: 0; 200; 255
        Enabled: true
        Head Diameter: 0.30000001192092896
        Head Length: 0.20000000298023224
        Length: 0.30000001192092896
        Line Style: Lines
        Line Width: 0.029999999329447746
        Name: Global Path
        Offset:
          X: 0
          Y: 0
          Z: 0
        Pose Color: 0; 200; 255
        Pose Style: None
        Radius: 0.029999999329447746
        Shaft Diameter: 0.10000000149011612
        Shaft Length: 0.10000000149011612
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /parrot1/plan
        Value: true
      Enabled: true
