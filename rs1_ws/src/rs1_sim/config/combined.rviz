# Shared mission overview. Requires the normal world_alignment node.
# Husky and Parrot keep their own topics/maps; this only combines their display.
# Toggle each robot's maps and sensors in the Displays panel when debugging.
# Start with one SLAM map to avoid overlapping occupancy grids. Camera/depth
# and 3D LiDAR displays are off to reduce visualisation work; rendering is 15 Hz.
# Use the dashboard for mission commands, or the separate RViz windows for
# robot-specific Nav2 controls. This shared view has no ambiguous goal tool.
Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Husky1
    - /Parrot1
    - /Mission1
    Splitter Ratio: 0.5
  Tree Height: 600
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_common/Group
    Name: Husky
    Enabled: true
    Displays:
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ''
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /husky1/robot_description
      Enabled: true
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ''
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_common/Group
      Displays:
      - Alpha: 0.699999988079071
        Class: rviz_default_plugins/Map
        Color Scheme: map
        Draw Behind: false
        Enabled: false
        Name: Global Costmap
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/global_costmap/costmap
        Update Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/global_costmap/costmap_updates
        Use Timestamp: false
        Value: false
      - Alpha: 0.699999988079071
        Class: rviz_default_plugins/Map
        Color Scheme: map
        Draw Behind: false
        Enabled: true
        Name: Local Costmap
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/local_costmap/costmap
        Update Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/local_costmap/costmap_updates
        Use Timestamp: false
        Value: true
      - Alpha: 0.699999988079071
        Class: rviz_default_plugins/Map
        Color Scheme: map
        Draw Behind: false
        Enabled: true
        Name: SLAM Map
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/map
        Update Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/map_updates
        Use Timestamp: false
        Value: true
      Enabled: true
      Name: Maps
    - Class: rviz_common/Group
      Displays:
      - Alpha: 1
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 10
          Min Value: -10
          Value: true
        Axis: Z
        Channel Name: intensity
        Class: rviz_default_plugins/LaserScan
        Color: 255; 255; 255
        Color Transformer: Intensity
        Decay Time: 0
        Enabled: true
        Invert Rainbow: false
        Max Color: 255; 255; 255
        Max Intensity: 0
        Min Color: 0; 0; 0
        Min Intensity: 0
        Name: Lidar2D
        Position Transformer: XYZ
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.10000000149011612
        Style: Points
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/scan
        Use Fixed Frame: true
        Use rainbow: true
        Value: true
      - Alpha: 1
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 10
          Min Value: -10
          Value: true
        Axis: Z
        Channel Name: intensity
        Class: rviz_default_plugins/PointCloud2
        Color: 255; 255; 255
        Color Transformer: Intensity
        Decay Time: 0
        Enabled: false
        Invert Rainbow: true
        Max Color: 255; 255; 255
        Max Intensity: 0
        Min Color: 0; 0; 0
        Min Intensity: 0
        Name: Lidar3D
        Position Transformer: XYZ
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.009999999776482582
        Style: Points
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/scan/points
        Use Fixed Frame: true
        Use rainbow: true
        Value: false
      Enabled: true
      Name: Lidar
    - Class: rviz_common/Group
      Displays:
      - Alpha: 1
        Buffer Length: 1
        Class: rviz_default_plugins/Path
        Color: 255; 170; 0
        Enabled: true
        Head Diameter: 0.30000001192092896
        Head Length: 0.20000000298023224
        Length: 0.30000001192092896
        Line Style: Lines
        Line Width: 0.029999999329447746
        Name: Local Plan
        Offset:
          X: 0
          Y: 0
          Z: 0
        Pose Color: 255; 170; 0
        Pose Style: None
        Radius: 0.029999999329447746
        Shaft Diameter: 0.10000000149011612
        Shaft Length: 0.10000000149011612
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/local_plan
        Value: true
      - Alpha: 1
        Buffer Length: 1
        Class: rviz_default_plugins/Path
        Color: 255; 170; 0
        Enabled: true
        Head Diameter: 0.30000001192092896
        Head Length: 0.20000000298023224
        Length: 0.30000001192092896
        Line Style: Lines
        Line Width: 0.029999999329447746
        Name: Global Path
        Offset:
          X: 0
          Y: 0
          Z: 0
        Pose Color: 255; 170; 0
        Pose Style: None
        Radius: 0.029999999329447746
        Shaft Diameter: 0.10000000149011612
        Shaft Length: 0.10000000149011612
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/plan
        Value: true
      Enabled: true
      Name: Planning
    - Class: rviz_common/Group
      Displays:
      - Class: rviz_default_plugins/Image
        Enabled: false
        Max Value: 1
        Median window: 5
        Min Value: 0
        Name: Camera
        Normalize Range: true
        Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/camera/image
        Value: false
      - Alpha: 1
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 10
          Min Value: -10
          Value: true
        Axis: Z
        Channel Name: intensity
        Class: rviz_default_plugins/PointCloud2
        Color: 255; 255; 255
        Color Transformer: RGB8
        Decay Time: 0
        Enabled: false
        Invert Rainbow: false
        Max Color: 255; 255; 255
        Max Intensity: 4096
        Min Color: 0; 0; 0
        Min Intensity: 0
        Name: Depth Pointcloud
        Position Transformer: XYZ
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.009999999776482582
        Style: Flat Squares
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /husky1/camera/depth/points
        Use Fixed Frame: true
        Use rainbow: true
        Value: false
      Enabled: false
      Name: RGBD
  - Class: rviz_common/Group
    Name: Parrot
    Enabled: true
    Displays:
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ''
      Description Source: Topic
