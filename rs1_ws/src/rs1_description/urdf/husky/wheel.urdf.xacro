<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
  <xacro:property name="wheel_separation" value="0.5708"/>
  <xacro:property name="wheel_radius" value="0.1651"/>

  <!-- Friction tuning: forward/backward and sideways respectively. -->
  <xacro:property name="wheel_mu_longitudinal" value="1.0"/>
  <xacro:property name="wheel_mu_lateral" value="0.3"/>

  <xacro:macro name="wheel" params="prefix wheel_id x_pos y_pos">
    <link name="${prefix}${wheel_id}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rs1_description/meshes/husky/wheel.dae"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
        <geometry>
          <cylinder length="0.1143" radius="${wheel_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.637"/>
        <inertia ixx="0.02467" ixy="0" ixz="0"
                 iyy="0.04411" iyz="0"
                 izz="0.02467"/>
      </inertial>
    </link>

    <!-- First friction direction follows wheel-local X, along the robot. -->
    <gazebo reference="${prefix}${wheel_id}_wheel_link">
      <mu1>${wheel_mu_longitudinal}</mu1>
      <mu2>${wheel_mu_lateral}</mu2>
      <fdir1>1 0 0</fdir1>
    </gazebo>

    <joint name="${prefix}${wheel_id}_wheel_joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${wheel_id}_wheel_link"/>
      <origin xyz="${x_pos} ${y_pos} 0.03282" rpy="0 0 0"/>
      <limit lower="-1e+16" upper="1e+16"
             effort="1e+16" velocity="1e+16"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.004"/>
    </joint>
  </xacro:macro>
</robot>