<?xml version="1.0"?>
<sdf version='1.8'>
  <world name="simple_trees">
    <!-- Basic world setup  -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <shadows>1</shadows>
    </scene>

    <!-- Initialise spherical coordinates somewhere -->
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- Small ground plane with grass texture -->
    <include>
      <uri>
        model://grass_plane
      </uri>
      <name>grass_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Oak tree (local copy in rs1_sim/models/trees - needs IGN_GAZEBO_RESOURCE_PATH
         to include rs1_ws/src/rs1_sim/models).
         Placed BEHIND the Parrot (negative X; the drone spawns at x=2 looking +X)
         so it is never in the sample-generator camera frame. -->
    <include>
      <uri>
        model://trees/oak_tree
      </uri>
      <name>oak1</name>
      <pose>-15.0 -12.0 0 0 0 0</pose>
    </include>

    <!-- Pine tree (local copy in rs1_sim/models/trees) - also behind the camera
         (previously at 5,0,0 it sat dead-centre in every sample image). -->
    <include>
      <uri>
        model://trees/pine_tree
      </uri>
      <name>pine1</name>
      <pose>-10.0 -15.0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
