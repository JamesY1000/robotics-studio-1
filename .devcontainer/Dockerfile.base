ARG ROS_DISTRO=humble
ARG ROS_BASE_IMAGE=ros:${ROS_DISTRO}-ros-base-jammy

# FROM ${ROS_BASE_IMAGE}
FROM osrf/ros:humble-desktop-full

# Setup environment
ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LANGUAGE=${LANG}
ENV LC_ALL=${LANG}

# Allow pip to install packages system-wide
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Install system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    curl wget git ca-certificates gnupg \
    build-essential nano \
    ccache \
    locales \
    doxygen \
    jq ripgrep fd-find shellcheck \
    cmake \
    gazebo \
    libglu1-mesa-dev \
    ruby-dev \
    tmux \
    xorg-dev \
    python3 python3-pip python3-venv python3-tk \
    python3-colcon-mixin \
    openssh-client \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    python3-pydantic \
    zsh \
    usbutils \
    && locale-gen en_US.UTF-8 \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install ROS 2 packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-joint-state-publisher \
    ros-humble-plotjuggler-ros \
    ros-humble-robot-localization \
    ros-humble-robot-state-publisher \
    ros-humble-ros2bag \
    ros-humble-rosbag2-storage-default-plugins \
    ros-humble-rqt-tf-tree \
    ros-humble-rmw-fastrtps-cpp \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rviz2 \
    ros-humble-slam-toolbox \
    ros-humble-turtlebot3 \
    ros-humble-turtlebot3-msgs \
    ros-humble-twist-mux \
    ros-humble-usb-cam \
    ros-humble-xacro \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Provided starter simulation
RUN apt-get update \
    && mkdir -p /etc/apt/keyrings \
    && wget -qO- http://packages.osrfoundation.org/gazebo.key | gpg --dearmor -o /etc/apt/keyrings/gazebo-archive-keyring.gpg \
    && . /etc/os-release \
    && echo "deb [signed-by=/etc/apt/keyrings/gazebo-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable ${UBUNTU_CODENAME} main" > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    ignition-fortress \
    ros-dev-tools \
    # ros-humble-robot-localization \
    ros-humble-ros-ign \
    ros-humble-ros-ign-interfaces \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    # ros-humble-slam-toolbox \
    ros-humble-turtlebot4-simulator \
    ros-humble-irobot-create-nodes \
    python3-numpy \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create and set user as 'ubuntu' with UID/GID 1000
RUN useradd -m -u 1000 -G sudo -s /usr/bin/zsh ubuntu
ENV USER=ubuntu

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi \
    && rosdep update --rosdistro $ROS_DISTRO

#  Pre-install Python dev tools globally
COPY .devcontainer/requirements.txt /tmp/devcontainer-requirements.txt
RUN pip install --no-cache-dir -r /tmp/devcontainer-requirements.txt \
    && rm /tmp/devcontainer-requirements.txt

WORKDIR /robotics-studio-1
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp