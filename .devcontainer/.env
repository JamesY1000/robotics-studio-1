# This file holds ultimate form of truth for all environment variables in the docker compose

# Working directory
WORKING_DIR=/robotics-studio-1


# Version tag
IMAGE_TAG=latest

# Auto-generated by the init script on first run and used in reusable image names.
PLATFORM=amd64

# "runc" for standard; "nvidia" for GPU hosts with NVIDIA Container Toolkit.
CONTAINER_RUNTIME=nvidia
# "no" for standard; "unless-stopped" survives host reboots but respects manual stops.
RESTART_POLICY=no

# ROS 2 and ubuntu distros we're using for this subject
ROS_DISTRO=humble
UBUNTU_DISTRO=jammy

IMG_NAME_DEVCONTAINER_BASE=devcontainer-base
IMG_NAME_DEVCONTAINER_USER=devcontainer-user

SELECTED_DEVCONTAINER=${IMG_NAME_DEVCONTAINER_USER}